# JWT Secret Key
JWT_SECRET_KEY=something

# Database URI for authentication service
DATABASE_URI=sqlite:///auth.db

# RabbitMQ connection details
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Any other environment variables needed by your app
FLASK_APP=app.py
FLASK_ENV=development



RESET_LINK_BASE=http://localhost:4200/v1/auth/reset-password
